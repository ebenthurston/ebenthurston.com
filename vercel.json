{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/post/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/archive/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/day/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/tagged/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/page/:path*",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/christina-harris",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/christina-harris/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
