---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Insights — Eben Thurston"
  description="Articles by Eben Thurston on GEO, AEO, and enterprise search strategy in the AI era."
>
  <h1>Insights</h1>
  <p class="lede">
    Notes on GEO, AEO, and enterprise search strategy — written from
    practice, not theory.
  </p>

  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/insights/${post.id}/`}>{post.data.title}</a>
        <br />
        <span class="meta">
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {' — '}
          {post.data.description}
        </span>
      </li>
    ))}
  </ul>
</Base>
