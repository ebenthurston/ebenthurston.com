---
/**
 * Homepage — the entity hub.
 * Everything an answer engine needs to know about Eben Thurston,
 * on one URL, in extractable declarative HTML, mirrored in JSON-LD.
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { linkedInPosts } from '../data/linkedin-posts';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const description =
  'Eben Thurston is a New York–based search marketing executive specializing ' +
  'in Generative Engine Optimization (GEO) and Answer Engine Optimization (AEO). ' +
  'He is Director of Search Marketing and Head of AI Search Strategy at TIAA.';

// FAQ content lives here once; rendered visibly below and mirrored
// verbatim into FAQPage structured data.
const faq = [
  {
    q: 'Who is Eben Thurston?',
    a:
      'Eben Thurston is a search marketing executive based in the New York City ' +
      'metropolitan area. He is Director of Search Marketing (SEO + SEM) and Head ' +
      'of AI Search (GEO/AEO) Strategy at TIAA, a $1.4T+ asset management ' +
      'organization. He has worked in digital marketing and search since 2000, ' +
      'with prior leadership roles at iQuanti, FULLBEAUTY Brands, Fareportal, ' +
      'Shutterstock, and Time Inc. He holds an MBA from Fordham University.',
  },
  {
    q: 'What is Generative Engine Optimization (GEO)?',
    a:
      'Generative Engine Optimization (GEO) is the practice of earning visibility ' +
      'and citations for a brand inside generative AI systems such as ChatGPT, ' +
      'Claude, Perplexity, Gemini, and Google AI Overviews. Where classic SEO ' +
      'optimizes for ranked links, GEO optimizes for being retrieved, trusted, ' +
      'and quoted in synthesized answers. It combines technical accessibility ' +
      'for AI crawlers, extractable fact-dense content, structured data, and ' +
      'off-site entity authority.',
  },
  {
    q: 'How is AEO different from traditional SEO?',
    a:
      'Answer Engine Optimization (AEO) targets systems that deliver a single ' +
      'synthesized answer rather than a page of ranked results. Traditional SEO ' +
      'success is measured in rankings and clicks; AEO success is measured in ' +
      'mention rate — how often a brand is named or cited across AI-generated ' +
      'answers. In practice the disciplines overlap heavily: strong entity ' +
      'signals, authoritative content, and clean technical foundations drive ' +
      'both, because most AI citations come from sources that already rank.',
  },
  {
    q: 'How do GEO and AEO fit into modern search marketing?',
    a:
      'GEO and AEO are extensions of search marketing, not replacements for ' +
      'it. Traditional SEO drives traffic through ranked links; SEM captures ' +
      'paid demand; AEO ensures a brand is accurately retrieved, trusted, and ' +
      'cited inside AI-synthesized answers. The underlying assets overlap — ' +
      'entity clarity, authoritative content, clean technical foundations — ' +
      'so treating SEO, SEM, and AEO as one unified discipline keeps a brand ' +
      'visible whether a user types a query into a classic search engine or ' +
      'asks a conversational answer engine.',
  },
  {
    q: 'What does Eben Thurston do at TIAA?',
    a:
      'At TIAA, Eben Thurston directs a unified Total Search growth engine ' +
      'across the TIAA and Nuveen brands, managing organic (SEO) and paid (SEM) ' +
      'search as a single commercial P&L. He leads the enterprise pivot to ' +
      'Generative Engine Optimization — developing the technical and content ' +
      'frameworks required to secure brand citations within LLMs including ' +
      'ChatGPT, Perplexity, and Claude, and in Google AI Overviews — while ' +
      'operating inside a highly regulated financial environment.',
  },
  {
    q: 'How do regulated brands earn visibility in AI answers?',
    a:
      'Regulated brands win AI visibility the same way they win regulatory ' +
      'trust: verifiable, compliance-approved claims published in ' +
      'machine-readable form. That means pre-rendered HTML that AI crawlers can ' +
      'actually read, structured data that removes ambiguity about the entity ' +
      'making each claim, fact-dense content mapped to real user prompts, and ' +
      'governance workflows that keep every extractable statement inside ' +
      'approved language. Constraint, handled well, becomes a citation ' +
      'advantage: answer engines favor precise, attributable sources.',
  },
];

// JSON-LD knowledge graph. One @graph, four nodes, cross-referenced by @id.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://ebenthurston.com/#person',
      name: 'Eben Thurston',
      url: 'https://ebenthurston.com/',
      email: 'mailto:eben.thurston@gmail.com',
      image: 'https://ebenthurston.com/eben-thurston.jpg',
      jobTitle:
        'Director, Search Marketing (SEO + SEM) | Head of AI Search (GEO/AEO) Strategy',
      worksFor: {
        '@type': 'Organization',
        name: 'TIAA',
        url: 'https://www.tiaa.org/',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'New York',
        addressRegion: 'NY',
        addressCountry: 'US',
      },
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Fordham University — Graduate School of Business Administration',
        },
        { '@type': 'CollegeOrUniversity', name: 'University of Vermont' },
      ],
      knowsAbout: [
        'Generative Engine Optimization (GEO)',
        'Answer Engine Optimization (AEO)',
        'Search Engine Optimization (SEO)',
        'Search Engine Marketing (SEM)',
        'AI search strategy',
        'Enterprise search marketing',
        'Digital marketing in regulated industries',
        'Customer acquisition and CAC optimization',
        'Marketing P&L management',
      ],
      sameAs: [
        'https://www.linkedin.com/in/ebenthurston',
        'https://www.crunchbase.com/person/eben-thurston',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://ebenthurston.com/#website',
      url: 'https://ebenthurston.com/',
      name: 'Eben Thurston',
      publisher: { '@id': 'https://ebenthurston.com/#person' },
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://ebenthurston.com/#profilepage',
      url: 'https://ebenthurston.com/',
      isPartOf: { '@id': 'https://ebenthurston.com/#website' },
      mainEntity: { '@id': 'https://ebenthurston.com/#person' },
      dateModified: new Date().toISOString(),
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://ebenthurston.com/#faq',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<Base title="Eben Thurston — Search Marketing & AI Search (GEO/AEO) Executive" description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <div class="hero">
    <div>
      <h1>Eben Thurston</h1>
      <p class="lede">
    Eben Thurston is a New York–based search marketing executive specializing in
    Generative Engine Optimization (GEO) and Answer Engine Optimization (AEO).
    He is Director of Search Marketing (SEO + SEM) and Head of AI Search
    Strategy at TIAA, a $1.4T+ asset management organization, and has led
    enterprise search programs since 2000 at companies including Shutterstock,
    Time Inc., and FULLBEAUTY Brands.
      </p>
    </div>
    <img
      class="headshot"
      src="/eben-thurston.jpg"
      alt="Eben Thurston, Director of Search Marketing and Head of AI Search Strategy at TIAA"
      width="576"
      height="576"
      loading="eager"
    />
  </div>

  <h2 id="key-facts">Key Facts</h2>
  <ul>
    <li>25+ years in digital marketing and search, starting as a front-end developer at Time Inc. in 2000.</li>
    <li>Directs enterprise search marketing (SEO + SEM) for TIAA and Nuveen — a $1.4T+ asset management organization — as a single commercial P&amp;L.</li>
    <li>An early mover in Generative Engine Optimization: built an agency's inaugural Generative AI practice within months of ChatGPT's launch.</li>
    <li>Develops frameworks that secure brand citations in ChatGPT, Perplexity, Claude, and Google AI Overviews for regulated financial brands.</li>
    <li>Led a 20-person cross-functional search team dedicated to a Top 3 global US bank.</li>
    <li>Directed 18 large-scale site migrations across the FULLBEAUTY Brands portfolio.</li>
    <li>Scaled Shutterstock's global search infrastructure across 20+ languages and territories.</li>
    <li>Two client properties he helped build were acquired: <a href="https://www.prnewswire.com/news-releases/webmd-acquires-additude-301299280.html">ADDitude Magazine (by WebMD)</a> and BobVila.com (by Recurrent Ventures).</li>
    <li>Managed content and technology partnerships with Google, Facebook, and Yahoo for Time Inc.</li>
    <li>Began his career on Wall Street (Morgan Stanley, Lehman Brothers, Goldman Sachs). MBA, Fordham University.</li>
  </ul>

  <h2 id="cv">CV</h2>

  <h3>Director, Search Marketing (SEO + SEM) &amp; Head of AI Search (GEO/AEO) Strategy — TIAA <span class="meta">(2024–present)</span></h3>
  <ul>
    <li>Directs a unified Total Search growth engine across TIAA and Nuveen, managing organic and paid search as one commercial P&amp;L for $1.4T+ asset management brands.</li>
    <li>Spearheads the enterprise pivot to GEO/AEO: technical and content frameworks that secure brand citations within LLMs and Google AI Overviews.</li>
    <li>Architects custom LLM workflows over cross-channel performance data, compressing review cycles from days to minutes and reducing blended search CAC.</li>
  </ul>

  <h3>Director, Search Marketing — iQuanti <span class="meta">(2021–2023)</span></h3>
  <ul>
    <li>Led a 20-person cross-functional team dedicated to a Top 3 global US bank, aligning technical SEO, UX, legal, and content strategy.</li>
    <li>Established the firm's inaugural Generative AI practice following the release of ChatGPT, positioning the agency as a first mover in AI-integrated search.</li>
    <li>Transitioned client investment models from traffic metrics to revenue-based attribution.</li>
  </ul>

  <h3>Director, Digital Marketing / Director, SEO — FULLBEAUTY Brands <span class="meta">(2017–2020)</span></h3>
  <ul>
    <li>Directed 18 large-scale site migrations across a multi-brand portfolio and owned the organic search P&amp;L.</li>
    <li>Led marketing and technical alignment through M&amp;A integrations; architected retention frameworks to maximize customer lifetime value.</li>
  </ul>

  <h3>Director, SEO &amp; Content Strategy — Fareportal <span class="meta">(2016–2017)</span></h3>
  <ul>
    <li>Architected a global SEO governance framework to rehabilitate domain authority in travel technology, recovering from legacy algorithmic penalties.</li>
  </ul>

  <h3>SEO Product Owner, Global — Shutterstock <span class="meta">(2012–2016)</span></h3>
  <ul>
    <li>Scaled global search infrastructure for millions of dynamic assets across 20+ languages and territories.</li>
    <li>Embedded SEO into core engineering sprints, making new platform features "discoverable by design."</li>
  </ul>

  <h3>Founder &amp; Managing Director — Spring Marketing Strategies <span class="meta">(2009–2012)</span></h3>
  <ul>
    <li>Founded and scaled a digital consultancy serving 30+ retainer clients, including Time Inc.</li>
    <li>Architected audience growth for BobVila.com (later acquired by Recurrent Ventures) and ADDitude Magazine (later <a href="https://www.prnewswire.com/news-releases/webmd-acquires-additude-301299280.html">acquired by WebMD</a>).</li>
  </ul>

  <h3>Earlier roles <span class="meta">(1998–2009)</span></h3>
  <ul>
    <li>Director, Marketing &amp; Audience Development — 1-800-FLOWERS.COM / Celebrations.com (2008–2009).</li>
    <li>Managing Director, Digital Marketing — Root Markets, a mortgage lead exchange co-founded by Lewis Ranieri (2007–2008).</li>
    <li>Time Inc. (2000–2007): web producer → front-end developer → web analytics manager → business development manager, negotiating partnerships with Google, Facebook, and Yahoo.</li>
    <li>Wall Street foundations: Morgan Stanley, Lehman Brothers, and Goldman Sachs (1998–2000).</li>
  </ul>

  <h3>Education</h3>
  <ul>
    <li>MBA, <a href="https://www.fordham.edu/gabelli-school-of-business/">Fordham University — Graduate School of Business Administration (Gabelli School)</a> (Marketing; Product Management).</li>
    <li>BA, Political Science &amp; English, University of Vermont.</li>
  </ul>

  <h2 id="faq">Frequently Asked Questions</h2>
  <dl class="faq">
    {faq.map((item) => (
      <>
        <dt>{item.q}</dt>
        <dd>{item.a}</dd>
      </>
    ))}
  </dl>

  <h2 id="insights">Insights</h2>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/insights/${post.id}/`}>{post.data.title}</a>
        <span class="meta">
          {' — '}
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </span>
        <br />
        <span class="meta">{post.data.description}</span>
      </li>
    ))}
  </ul>

  <p>Selected posts on LinkedIn:</p>
  <ul>
    {linkedInPosts.map((post) => (
      <li><a href={post.url}>{post.title}</a></li>
    ))}
  </ul>

  <h2 id="projects">Projects</h2>
  <p>
    Eben Thurston builds AI-assisted web apps as working experiments in
    AI-driven ("vibe-coded") software development:
  </p>
  <ul>
    <li><a href="/golf/">BallFlight</a> — a golf setup and ball-flight physics sandbox.</li>
    <li><a href="/freethrow/">FreeThrow</a> — a basketball shot-mechanics and make-percentage sandbox.</li>
  </ul>

  <h2 id="profiles">Profiles</h2>
  <p>Eben Thurston is active on these platforms:</p>
  <ul>
    <li><a href="https://www.linkedin.com/in/ebenthurston">LinkedIn</a></li>
    <li><a href="https://www.crunchbase.com/person/eben-thurston">Crunchbase</a></li>
    <!-- Add additional verified profiles here as they are aligned
         (X, GitHub, Crunchbase, Muck Rack, …) and mirror each one
         in the Person sameAs array above. -->
  </ul>

  <h2 id="contact">Contact</h2>
  <p>
    Email <a href="mailto:eben.thurston@gmail.com">eben.thurston@gmail.com</a>
    or connect on <a href="https://www.linkedin.com/in/ebenthurston">LinkedIn</a>.
  </p>
</Base>
