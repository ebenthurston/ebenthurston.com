---
/**
 * Homepage: the entity hub.
 * Everything an answer engine needs to know about Eben Thurston,
 * on one URL, in extractable declarative HTML, mirrored in JSON-LD.
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { linkedInPosts } from '../data/linkedin-posts';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const description =
  'Eben Thurston has worked in digital marketing and search for over 20 years. ' +
  'Most recently Director, Integrated Search at TIAA, a Fortune 100 firm.';

// FAQ content lives here once; rendered visibly below and mirrored
// verbatim into FAQPage structured data.
const faq = [
  {
    q: 'Who is Eben Thurston?',
    a:
      'Eben Thurston is a search marketing executive based in the New York ' +
      'City metropolitan area, who runs organic, paid, and AI search as one ' +
      'commercial P&L for enterprise brands. He was most recently ' +
      'Director, Integrated Search at TIAA (2024-2026), and has held search ' +
      'leadership roles at iQuanti, FULLBEAUTY Brands, Fareportal, ' +
      'Shutterstock, and Time Inc. He holds an MBA from Fordham University.',
  },
  {
    q: 'What is Generative Engine Optimization (GEO)?',
    a:
      'Generative Engine Optimization (GEO) is the practice of earning visibility ' +
      'and citations for a brand inside generative AI systems such as ChatGPT, ' +
      'Claude, Perplexity, Gemini, and Google AI Overviews. Where classic SEO ' +
      'optimizes for ranked links, GEO optimizes for being retrieved, trusted, ' +
      'and quoted in synthesized answers. It combines technical accessibility ' +
      'for AI crawlers, extractable fact-dense content, structured data, and ' +
      'off-site entity authority.',
  },
  {
    q: 'How is AEO different from traditional SEO?',
    a:
      'Answer Engine Optimization (AEO) targets systems that deliver a single ' +
      'synthesized answer rather than a page of ranked results. Traditional SEO ' +
      'success is measured in rankings and clicks; AEO success is measured in ' +
      'mention rate: how often a brand is named or cited across AI-generated ' +
      'answers. In practice the disciplines overlap heavily: strong entity ' +
      'signals, authoritative content, and clean technical foundations drive ' +
      'both, because most AI citations come from sources that already rank.',
  },
  {
    q: 'How do GEO and AEO fit into modern search marketing?',
    a:
      'GEO and AEO are extensions of search marketing, not replacements for ' +
      'it. Traditional SEO drives traffic through ranked links; SEM captures ' +
      'paid demand; AEO ensures a brand is accurately retrieved, trusted, and ' +
      'cited inside AI-synthesized answers. The underlying assets overlap ' +
      '(entity clarity, authoritative content, clean technical foundations), ' +
      'so treating SEO, SEM, and AEO as one unified discipline keeps a brand ' +
      'visible whether a user types a query into a classic search engine or ' +
      'asks a conversational answer engine.',
  },
  {
    q: 'What did Eben Thurston do at TIAA?',
    a:
      'As Director, Integrated Search at TIAA from 2024 to 2026, Eben ' +
      'Thurston ran organic and paid search across the TIAA and Nuveen ' +
      'brands as a single commercial P&L. He led the enterprise move into ' +
      'Generative Engine Optimization, growing brand mentions in Google AI ' +
      'Overviews 1,714% and AI-referred sessions 1,214%, while lifting ' +
      'organic clicks 528% year over year and outranking Fidelity, ' +
      'Vanguard, and Schwab on core category terms.',
  },
  {
    q: 'How do regulated brands earn visibility in AI answers?',
    a:
      'Regulated brands win AI visibility the same way they win regulatory ' +
      'trust: verifiable, compliance-approved claims published in ' +
      'machine-readable form. That means pre-rendered HTML that AI crawlers can ' +
      'actually read, structured data that removes ambiguity about the entity ' +
      'making each claim, fact-dense content mapped to real user prompts, and ' +
      'governance workflows that keep every extractable statement inside ' +
      'approved language. Constraint, handled well, becomes a citation ' +
      'advantage: answer engines favor precise, attributable sources.',
  },
];

// JSON-LD knowledge graph. One @graph, four nodes, cross-referenced by @id.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://ebenthurston.com/#person',
