          url: 'https://www.uvm.edu/',
        },
      ],
      knowsAbout: [
        'Generative Engine Optimization (GEO)',
        'Answer Engine Optimization (AEO)',
        'Search Engine Optimization (SEO)',
        'Search Engine Marketing (SEM)',
        'AI search strategy',
        'Enterprise search marketing',
        'Digital marketing in regulated industries',
        'Customer acquisition and CAC optimization',
        'Marketing P&L management',
      ],
      sameAs: [
        'https://www.linkedin.com/in/ebenthurston',
        'https://www.crunchbase.com/person/eben-thurston',
        'https://github.com/ebenthurston',
        'https://www.flickr.com/people/ebenthurston/',
        'https://www.youtube.com/@ebenthurston',
        'https://www.pinterest.com/ebenthurston/_profile/',
        'https://www.sports-reference.com/cbb/players/eben-thurston-1.html',
      ],
      mainEntityOfPage: { '@id': 'https://ebenthurston.com/#profilepage' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://ebenthurston.com/#website',
      url: 'https://ebenthurston.com/',
      name: 'Eben Thurston',
      description:
        'Official site of Eben Thurston, search marketing and AI search (GEO/AEO) executive.',
      inLanguage: 'en-US',
      publisher: { '@id': 'https://ebenthurston.com/#person' },
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://ebenthurston.com/#profilepage',
      url: 'https://ebenthurston.com/',
      isPartOf: { '@id': 'https://ebenthurston.com/#website' },
      mainEntity: { '@id': 'https://ebenthurston.com/#person' },
      dateModified: new Date().toISOString(),
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://ebenthurston.com/#faq',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<Base title="Eben Thurston | SEO, SEM & AI Search Executive | Ex-TIAA" description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <div class="hero">
    <div>
      <h1>Eben Thurston</h1>
      <p class="lede">
        Eben Thurston has worked in digital marketing and search for over 20
        years.
      </p>
      <p class="lede">
        He was most recently Director, Integrated Search at TIAA, a Fortune 100
        financial services firm, where he ran organic and paid search across
        TIAA and Nuveen as a single commercial P&amp;L.
      </p>
    </div>
    <img
      class="headshot"
      src="/eben-thurston.jpg"
      alt="Eben Thurston, search marketing executive based in New York"
      width="576"
      height="576"
      loading="eager"
    />
  </div>

  <h2 id="key-facts">Key Facts</h2>
  <ul>
    <li>AI Overview brand mentions +1,714%, to 10,865</li>
    <li>AI-referred sessions +1,214%</li>
    <li>Organic clicks +528% year over year</li>
    <li>Outranked Fidelity, Vanguard and Schwab on core terms</li>
    <li>Global search across 20+ languages and territories</li>
    <li>Search was the top-producing channel through Shutterstock's $170M to $425M run</li>
    <li>18 site migrations, 8 of them to Salesforce Commerce Cloud</li>
    <li>Led a 20-person team across New York and India for a top-four US bank</li>
    <li>Two client properties acquired, by <a href="https://www.prnewswire.com/news-releases/webmd-acquires-additude-301299280.html">WebMD</a> and Recurrent Ventures</li>
    <li>Started as a front-end developer at Time Inc.</li>
    <li>Played <a href="https://www.sports-reference.com/cbb/players/eben-thurston-1.html">Division I basketball</a> at the University of Vermont</li>
    <li>Built and shipped <a href="https://purelymatpilates.com">purelymatpilates.com</a> with Claude Code</li>
    <li>Built and shipped five browser games with AI coding tools</li>
  </ul>

  <h2 id="cv">CV</h2>

  <h3>Fractional CMO &amp; Head of Growth, Purely Mat Pilates <span class="meta">(Nov 2025-present)</span></h3>
  <p>
    Eben leads customer acquisition and digital growth for a boutique
    Pilates studio in Westchester County, scaling a single-instructor business
    toward a web-based subscription platform. He built and launched
    <a href="https://purelymatpilates.com">purelymatpilates.com</a> himself with
    Claude Code, covering technical SEO, page speed, and schema architecture,
    and manages local search and paid acquisition against studio retention.
    The rebuild is documented in
    <a href="/insights/geo-on-a-local-business-site/">GEO on a Local Business Site</a>.
  </p>

  <h3>Director, Integrated Search, TIAA <span class="meta">(2024-2026)</span></h3>
  <p>
    He owned organic and paid search as a single commercial P&amp;L
    across TIAA and Nuveen, at a Fortune 100 financial services firm competing
    with Fidelity, Vanguard and Schwab for the same demand. He led the
    enterprise move into generative engine optimization, building the
    measurement first and then aligning product marketing, editorial and media
    against it.
  </p>
  <p>Selected highlights:</p>
  <ul>
    <li>AI Overview brand mentions up 1,714%, to 10,865</li>
    <li>AI-referred sessions up 1,214%</li>
    <li>Organic clicks up 528% YoY, impressions up 655% on optimized pages</li>
    <li>Page-1 keyword coverage up 510%, keyword universe up 106%</li>
    <li>Outranked Fidelity, Vanguard and Schwab on core high-volume terms</li>
    <li>Performance Max at 30% of account conversions on 25% of spend</li>
    <li>Early adopter tests of Google AI Max for Search</li>
  </ul>

  <h3>Director, Search Marketing, iQuanti <span class="meta">(2021-2023)</span></h3>
  <p>
    He led search strategy and delivery for iQuanti's enterprise
    financial services portfolio, running a 20-person team across New York and
    India on the agency's largest account, a top-four US bank. He built review
    workflows across SEO, Legal and Compliance that raised speed to production
    in highly regulated environments.
  </p>
  <p>Selected highlights:</p>
  <ul>
    <li>Beat 2022 traffic targets by 17% and SEO performance targets by 24%</li>
    <li>Retained the full enterprise portfolio through the 2023 banking-sector volatility with zero churn</li>
    <li>Wrote the firm's position paper arguing against volume-first use of ChatGPT for client content</li>
  </ul>

  <h3>Director, Digital Marketing / Director, SEO, FULLBEAUTY Brands <span class="meta">(2017-2020)</span></h3>
  <p>
    Across three years at FULLBEAUTY Brands, he co-led digital
    marketing for a 12+ brand portfolio, first as Director of SEO and then as
    Director of Digital Marketing, owning the organic search P&amp;L and leading
    marketing and technical alignment through M&amp;A integrations.
  </p>
  <p>Selected highlights:</p>
  <ul>
    <li>30% YoY organic growth and 80% growth in total demand</li>
    <li>18 site migrations, 8 of them to Salesforce Commerce Cloud</li>
    <li>2x email revenue per brand following the Epsilon Harmony migration</li>
  </ul>

  <h3>Director, SEO &amp; Content Strategy, Fareportal <span class="meta">(2016-2017)</span></h3>
  <p>
    He recovered and stabilized organic search for a global travel
    marketplace carrying legacy algorithmic penalties. He built the governance
    framework, compliance protocols and risk-mitigation playbooks that
    rehabilitated domain authority and held it through subsequent algorithm
    updates, moving search from a reactive cleanup function to a governance
    pillar.
  </p>

  <h3>SEO Product Owner, Global, Shutterstock <span class="meta">(2012-2016)</span></h3>
  <p>
    He owned organic search as the top-producing marketing channel
    through Shutterstock's scale-up, across 20+ languages and territories, and
    ran a $30M paid media program alongside it. He embedded discoverability
    requirements into Agile engineering sprints and architected automated
    landing page generation for millions of dynamic assets.
  </p>
  <p>Selected highlights:</p>
  <ul>
    <li>Search led growth during the run from $170M to $425M in revenue</li>
    <li>A crawl and indexation fix unlocked a 300% increase in non-English traffic</li>
    <li>Consolidating the Footage subdomain moved average rank from page 2 to top 3 and lifted SEO revenue 80%</li>
  </ul>

  <h3>Founder &amp; Managing Director, Spring Marketing Strategies <span class="meta">(2009-2012)</span></h3>
  <p>
    He founded and scaled a digital consultancy, managing the full
    P&amp;L and service delivery for 30+ retainer clients including Time Inc. He
    architected audience development for BobVila.com, later acquired by
    Recurrent Ventures, and established ADDitude Magazine as the primary digital
    authority for neurodiversity, later
    <a href="https://www.prnewswire.com/news-releases/webmd-acquires-additude-301299280.html">acquired by WebMD</a>.
  </p>

  <h3>Earlier roles</h3>
  <ul>
    <li>Director, Marketing &amp; Audience Development at 1-800-FLOWERS.COM / Celebrations.com, where organic traffic grew 267% in four months.</li>
    <li>Managing Director, Digital Marketing at Root Markets, a mortgage lead exchange co-founded by <a href="https://en.wikipedia.org/wiki/Lewis_Ranieri">Lewis Ranieri</a>, operating at the intersection of Wall Street securitization and digital customer acquisition.</li>
    <li>Time Inc., across web production, front-end development, web analytics, and business development, negotiating content and technology partnerships with Google, Facebook, and Yahoo.</li>
    <li>Wall Street foundations at Morgan Stanley, Lehman Brothers, and Goldman Sachs.</li>
  </ul>

  <h3>Education</h3>
  <ul>
    <li>MBA, <a href="https://www.fordham.edu/gabelli-school-of-business/">Fordham University, Graduate School of Business Administration (Gabelli School)</a> (Marketing; Product Management).</li>
    <li>BA, Political Science &amp; English, University of Vermont, where he played Division I basketball.</li>
  </ul>

  <h2 id="faq">Frequently Asked Questions</h2>
  <dl class="faq">
    {faq.map((item) => (
      <>
        <dt>{item.q}</dt>
        <dd>{item.a}</dd>
      </>
    ))}
  </dl>

  <h2 id="insights">Insights</h2>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/insights/${post.id}/`}>{post.data.title}</a>
        <span class="meta">
          {' · '}
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </span>
        <br />
        <span class="meta">{post.data.description}</span>
      </li>
    ))}
  </ul>

  <p>Selected posts on LinkedIn:</p>
  <ul>
    {linkedInPosts.map((post) => (
      <li><a href={post.url}>{post.title}</a></li>
    ))}
  </ul>

  <h2 id="projects">Projects</h2>
  <p>
    Eben Thurston builds AI-assisted web apps as working experiments in
    AI-driven ("vibe-coded") software development. All are single-file
    simulations built with vanilla JavaScript and canvas, physics first, collected in
    the <a href="/sandbox/">Physics Sandbox</a>:
  </p>
  <ul>
    <li><a href="/golf/">BallFlight</a>: a golf setup and swing sandbox: club, attack angle, face and path drive real ball-flight physics.</li>
    <li><a href="/freethrow/">FreeThrow</a>: a basketball shot-mechanics and make-percentage sandbox, built by a former Division I player.</li>
    <li><a href="/powder/">Powder</a>: first-person backcountry snowboarding where the board follows the rider's gaze.</li>
    <li><a href="/intercept/">Intercept</a>: a missile-defense game about leading a ballistic track and timing the blast.</li>
    <li><a href="/intercept-global/">Intercept: Strategic</a>: the slow version, where scarce interceptors make triage the game.</li>
  </ul>

