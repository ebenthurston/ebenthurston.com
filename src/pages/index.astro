      familyName: 'Thurston',
      url: 'https://ebenthurston.com/',
      email: 'mailto:eben.thurston@gmail.com',
      image: 'https://ebenthurston.com/eben-thurston.jpg',
      description:
        'Eben Thurston has worked in digital marketing and search for over 20 ' +
        'years. Most recently Director, Integrated Search at TIAA (2024-2026), ' +
        'a Fortune 100 financial services firm, where he ran organic and paid ' +
        'search across TIAA and Nuveen as a single commercial P&L.',
      jobTitle: 'Fractional CMO and Head of Growth',
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Search Marketing Executive',
        occupationalCategory: '11-2021.00',
        description:
          'Directs organic search (SEO), paid search (SEM), and AI search ' +
          '(GEO/AEO) as integrated in-house channels for enterprise brands.',
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Purely Mat Pilates',
        url: 'https://purelymatpilates.com',
      },
      address: {
        '@type': 'PostalAddress',
